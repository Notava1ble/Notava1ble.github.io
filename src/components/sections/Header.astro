---
import { buttonVariants } from "../ui/button";
import { cn } from "@/lib/utils";

import GitHubIcon from "../../assets/icons/brand-github.svg";
import LinkedInIcon from "../../assets/icons/brand-linkedin.svg";
import { ArrowRight, FileUser } from "lucide-react";
---

<header class="flex mt-12 gap-4 min-w-0">
  <div class="flex-2 space-y-4 min-w-0">
    <div class="space-y-1">
      <h1 class="font-bold text-4xl break-words">
        Hello, I'm <span class="text-red-400" transition:name="name"
          >Visar Mullaj</span
        >
      </h1>
      <p class="text-muted-foreground text-lg">Web Developer</p>
    </div>
    <p>
      Frontend-focused full-stack developer building real-time apps, internal tools, and practical consumer products. Strong in React/TypeScript with end-to-end ownership from backend workflows to polished UI.
    </p>
    <div class="flex gap-3">
      <a
        href="https://github.com/Notava1ble"
        target="_blank"
        class={cn(buttonVariants({ variant: "outlineTransparent" }))}
      >
        <GitHubIcon /> GitHub
      </a>
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noreferrer"
        class={cn(buttonVariants({ variant: "outlineTransparent" }))}
      >
        <FileUser /> Resume
      </a>
      <a
        href="https://www.linkedin.com/in/visar-mullaj/"
        target="_blank"
        aria-label="LinkedIn"
        class={cn(buttonVariants({ variant: "outlineTransparent" }))}
      >
        <LinkedInIcon />
      </a>
      <a href="/about" class={cn(buttonVariants({ variant: "link" }))}>
        More <ArrowRight />
      </a>
    </div>
  </div>
</header>
